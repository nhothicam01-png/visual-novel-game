          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đến lượt mình. Phóng to, trôi nhẹ, thở, bước vào, mờ dần và đung đưa mềm đều là chuyển động của nhân vật.",
      "gain": 1,
      "scene_index": 0,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 16.3984,
