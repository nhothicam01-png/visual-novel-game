          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cơn mưa đã tạnh. Không còn mưa, không còn sét; câu này phải có mảng hiệu ứng rỗng.",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
