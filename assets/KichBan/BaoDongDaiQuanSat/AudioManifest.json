          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đã dừng gió và lá rồi. Câu này không có hiệu ứng; mình cần thấy cảnh đứng yên để kiểm tra việc bỏ tick.",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
