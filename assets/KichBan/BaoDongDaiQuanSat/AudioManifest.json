        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Câu này chỉ nói về các hiệu ứng vừa thử, nhưng không yêu cầu bật lại chúng. Màn hình phải trở về bình thường.",
      "gain": 1,
      "scene_index": 0,
      "timing_policy": "fixed_source_window"
    },
    {
