        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bây giờ thử nền: phóng gần, trượt trái, trượt phải, trôi, làm mờ và nhịp sáng.",
      "gain": 1,
      "scene_index": 0,
