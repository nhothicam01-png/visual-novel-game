          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình chỉ muốn camera rung, zoom gần, kéo ra và trôi nhẹ. Không di chuyển vị trí sprite nhé.",
      "gain": 1,
      "scene_index": 0,
      "timing_policy": "fixed_source_window"
    },
    {
