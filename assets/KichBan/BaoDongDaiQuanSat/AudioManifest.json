          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không khí lạnh đi: tuyết rơi, sương mù phủ thấp, bong bóng nổi lên và những tia nắng xuyên qua mây.",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
