          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ngoài sân, gió bắt đầu thổi. Lá và cánh hoa bay qua, bụi mịn lấp lánh trong không khí.",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
