          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Chiếc chìa khóa vừa khớp với ổ khóa dưới chân kệ sách. Có tiếng chốt cửa bật ra rồi!",
      "gain": 1,
      "scene_index": 4,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 132.4377,
      "end": 136.8882,
      "duration": 4.4505,
      "pause_after": 0.6229000000003797,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Pipun, lùi sang phải. Mình sẽ kéo cánh cửa này, cậu đừng đứng ngay trước khe mở!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 137.8939,
      "end": 142.4684,
      "duration": 4.5745,
      "pause_after": 0.5070999999996335,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình giữ được rồi! Nhưng phía sau cửa không phải căn phòng... nó giống một hành lang khác đang xoay vòng!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 143.3597,
      "end": 148.2415,
      "duration": 4.8818,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình thấy ánh đèn của hai cậu! Mình đang ở sát cửa, nhưng có một cái bóng đứng chắn giữa chúng ta!",
      "gain": 1,
      "scene_index": 6,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 148.8337,
      "end": 151.4884,
      "duration": 2.6547,
      "pause_after": 2.418400000000384,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu, cúi xuống! Cái bóng vừa lao về phía cậu!",
      "gain": 1,
      "scene_index": 7,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 154.4383,
      "end": 159.0484,
      "duration": 4.6101,
      "pause_after": 0.4604000000003854,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Á! Mình né được rồi. Cái bóng đập vào kệ sách, còn chiếc chìa khóa vẫn ở trong tay mình!",
      "gain": 1,
      "scene_index": 8,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 159.8704,
      "end": 163.3782,
      "duration": 3.5078,
      "pause_after": 1.55960000000149,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cánh cửa đã mở hẳn! Bubu, chạy về phía ánh đèn, đừng nhìn lại!",
      "gain": 1,
      "scene_index": 9,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 165.2973,
      "end": 166.7281,
      "duration": 1.4308,
      "pause_after": 3.673500000000013,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình chạy đây! Đợi mình với!",
      "gain": 1,
      "scene_index": 10,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 170.8111,
      "end": 173.5081,
      "duration": 2.697,
      "pause_after": 2.4014999999999933,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu đã ra tới hành lang! Rerin, kéo cậu ấy qua đây!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 176.3107,
      "end": 178.3983,
      "duration": 2.0876,
      "pause_after": 2.9945999999996165,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nắm lấy tay mình! Một, hai, ba... kéo!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 181.8148,
      "end": 185.7992,
      "duration": 3.9844,
      "pause_after": 1.0943000000007377,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình ra được rồi! Hai cậu có sao không? Mình xin lỗi vì đã tự ý tách nhóm.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 187.3398,
      "end": 192.0551,
      "duration": 4.7153,
      "pause_after": 0.3244000000003897,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không sao, nhưng lần sau phải đi cùng nhau. Nhìn sau lưng cậu kìa... cái bóng vẫn đang ở trong đó!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 192.7634,
      "end": 197.629,
      "duration": 4.8656,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng quay lại. Chúng ta rời khỏi đây theo lối cầu thang, giữ khoảng cách vừa đủ và nhìn thấy nhau.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 198.2542,
      "end": 202.5784,
      "duration": 4.3242,
      "pause_after": 0.7209999999999983,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Sân trường đây rồi! Nhưng đồng hồ trên tường vẫn đứng đúng ở thời điểm chúng ta bước vào.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 203.7198,
      "end": 206.9882,
      "duration": 3.2684,
      "pause_after": 1.798500000000013,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình tưởng đã thoát, nhưng tiếng gõ lại vang lên từ phía sau cổng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 209.218,
      "end": 214.3783,
      "duration": 5.1603,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không ai trả lời. Cứ đi tiếp. Ba tiếng gõ không còn là lời gọi nữa, nó đang cố bắt chước chúng ta.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 214.9495,
      "end": 218.0324,
      "duration": 3.0829,
      "pause_after": 2.0012999999988725,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Khoan, nhìn bóng của ba đứa mình trên nền. Có bốn cái bóng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 220.4431,
      "end": 222.1683,
      "duration": 1.7252,
      "pause_after": 3.3518999999985173,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng đếm nữa! Chạy ra cổng thôi!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 225.935,
      "end": 229.5632,
      "duration": 3.6282,
      "pause_after": 1.4534999999999858,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ra ngoài rồi! Đứng dưới đèn đường, kiểm tra xem cả ba có đủ không.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 231.3939,
      "end": 236.4819,
      "duration": 5.088,
      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Một, hai, ba... đủ cả. Nhưng trên tay Bubu có vết mực mới, giống hệt dòng chữ trong cuốn sổ.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 237.0516,
      "end": 242.0511,
      "duration": 4.9995,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Dòng chữ gì cơ? 'Lần sau, hãy gõ bốn tiếng'. Không thể nào... mình đâu có mang cuốn sổ ra!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 242.6704,
      "end": 246.8483,
      "duration": 4.1779,
      "pause_after": 0.864599999999621,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Về nhà ngay. Chuyện này chưa kết thúc, nhưng lần tới chúng ta sẽ không đi vào đó một mình.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    }
  ]
}