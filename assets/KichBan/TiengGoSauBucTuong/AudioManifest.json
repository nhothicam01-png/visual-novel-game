          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Khoan đã, có tiếng gõ ngay sau bức tường bên trái. Mình chỉ nhìn qua ô cửa kính thôi!",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
