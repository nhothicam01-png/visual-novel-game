          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bức tường đang rung. Lùi lại! Có thứ gì đó đang đẩy từ phía bên kia!",
