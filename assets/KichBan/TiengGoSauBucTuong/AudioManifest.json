          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Có ai vừa đứng sau kệ sách không? Mình nhìn thấy bóng của mình... nhưng nó không cử động cùng lúc!",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 57.0737,
      "end": 60.8702,
      "duration": 3.7965,
      "pause_after": 0.25,
      "speaker": "Bubu",
