          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu, đừng tách ra! Cậu nghe Rerin dặn rồi mà!",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
