          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Trong sổ ghi: 'Đừng trả lời tiếng gõ thứ tư'. Vậy ba tiếng gõ lúc nãy là để gọi mình sao?",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 52.4235,
      "end": 56.8237,
      "duration": 4.4002,
      "pause_after": 0.25,
      "speaker": "Bubu",
