          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu! Cậu ở đâu? Tiếng gọi vừa phát ra từ phía thư viện, nhưng cửa thư viện lại nằm ở cuối hành lang!",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 71.7905,
      "end": 76.7131,
