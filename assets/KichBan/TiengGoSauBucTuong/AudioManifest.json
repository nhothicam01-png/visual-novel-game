      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 87.5173,
      "end": 92.0684,
      "duration": 4.5511,
      "pause_after": 0.25,
      "speaker": "Pipun",
