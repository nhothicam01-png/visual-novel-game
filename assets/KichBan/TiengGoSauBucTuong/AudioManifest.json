          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình nghe tiếng gõ thứ tư rồi! Không, mình sẽ không trả lời. Mình phải tìm cách báo cho hai cậu.",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
