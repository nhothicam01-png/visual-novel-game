          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cửa biến mất rồi. Trên bàn có một cuốn sổ mở sẵn, trang giấy đang tự lật!",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
