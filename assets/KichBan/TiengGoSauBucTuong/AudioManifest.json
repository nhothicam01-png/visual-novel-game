          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cánh cửa tự hé ra... bên trong có ánh đèn. Mình đứng ngay ngưỡng cửa, không đi xa đâu!",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
