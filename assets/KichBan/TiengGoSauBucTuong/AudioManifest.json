          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bóng đó đang giơ tay chỉ xuống sàn. Có một chiếc chìa khóa nằm dưới tấm thảm!",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
