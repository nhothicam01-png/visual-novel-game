          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cộc... cộc... cộc! Có tiếng đáp lại từ sau bức tường. Bubu, nếu nghe thấy thì lùi khỏi cửa nhé!",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
