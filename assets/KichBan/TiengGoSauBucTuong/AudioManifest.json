          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình nghe ba tiếng, nghỉ một nhịp, rồi lại ba tiếng. Nó giống như có ai đang gõ theo quy luật.",
      "gain": 1,
      "scene_index": 0,
