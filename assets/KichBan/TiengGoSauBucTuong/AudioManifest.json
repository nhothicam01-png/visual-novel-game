          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Chiếc chìa khóa vừa khớp với ổ khóa dưới chân kệ sách. Có tiếng chốt cửa bật ra rồi!",
      "gain": 1,
      "scene_index": 4,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 131.9058,
      "end": 136.07,
      "duration": 4.1642,
      "pause_after": 0.8834999999999926,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Pipun, lùi sang phải. Mình sẽ kéo cánh cửa này, cậu đừng đứng ngay trước khe mở!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 137.3644,
      "end": 141.9098,
      "duration": 4.5454,
      "pause_after": 0.47050000000001013,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình giữ được rồi! Nhưng phía sau cửa không phải căn phòng... nó giống một hành lang khác đang xoay vòng!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 142.7577,
      "end": 147.7396,
      "duration": 4.9819,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình thấy ánh đèn của hai cậu! Mình đang ở sát cửa, nhưng có một cái bóng đứng chắn giữa chúng ta!",
      "gain": 1,
      "scene_index": 6,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 148.3891,
      "end": 150.9696,
      "duration": 2.5805,
      "pause_after": 2.4242999999989028,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu, cúi xuống! Cái bóng vừa lao về phía cậu!",
      "gain": 1,
      "scene_index": 7,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 153.8161,
      "end": 158.3797,
      "duration": 4.5636,
      "pause_after": 0.46279999999890187,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Á! Mình né được rồi. Cái bóng đập vào kệ sách, còn chiếc chìa khóa vẫn ở trong tay mình!",
      "gain": 1,
      "scene_index": 8,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 159.2434,
      "end": 162.8498,
      "duration": 3.6064,
      "pause_after": 1.395599999999627,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cánh cửa đã mở hẳn! Bubu, chạy về phía ánh đèn, đừng nhìn lại!",
      "gain": 1,
      "scene_index": 9,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 164.671,
      "end": 166.1996,
      "duration": 1.5286,
      "pause_after": 3.4848999999984986,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình chạy đây! Đợi mình với!",
      "gain": 1,
      "scene_index": 10,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 170.0984,
      "end": 172.8497,
      "duration": 2.7513,
      "pause_after": 2.3017999999989005,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu đã ra tới hành lang! Rerin, kéo cậu ấy qua đây!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 175.6337,
      "end": 177.7998,
      "duration": 2.1661,
      "pause_after": 2.847699999999259,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nắm lấy tay mình! Một, hai, ba... kéo!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 181.1606,
      "end": 185.14,
      "duration": 3.9794,
      "pause_after": 0.9819000000003602,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình ra được rồi! Hai cậu có sao không? Mình xin lỗi vì đã tự ý tách nhóm.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 186.5923,
      "end": 191.2796,
      "duration": 4.6873,
      "pause_after": 0.28300000000001013,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không sao, nhưng lần sau phải đi cùng nhau. Nhìn sau lưng cậu kìa... cái bóng vẫn đang ở trong đó!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 191.9123,
      "end": 196.7295,
      "duration": 4.8172,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng quay lại. Chúng ta rời khỏi đây theo lối cầu thang, giữ khoảng cách vừa đủ và nhìn thấy nhau.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 197.3379,
      "end": 201.8199,
      "duration": 4.482,
      "pause_after": 0.5685999999996287,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Sân trường đây rồi! Nhưng đồng hồ trên tường vẫn đứng đúng ở thời điểm chúng ta bước vào.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 202.7662,
      "end": 205.9744,
      "duration": 3.2082,
      "pause_after": 1.8220999999996312,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình tưởng đã thoát, nhưng tiếng gõ lại vang lên từ phía sau cổng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 208.2908,
      "end": 213.46,
      "duration": 5.1692,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không ai trả lời. Cứ đi tiếp. Ba tiếng gõ không còn là lời gọi nữa, nó đang cố bắt chước chúng ta.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 214.1382,
      "end": 217.1597,
      "duration": 3.0215,
      "pause_after": 1.9529999999999976,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Khoan, nhìn bóng của ba đứa mình trên nền. Có bốn cái bóng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 219.5586,
      "end": 221.2094,
      "duration": 1.6508,
      "pause_after": 3.3660000000000085,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng đếm nữa! Chạy ra cổng thôi!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 225.0754,
      "end": 228.6214,
      "duration": 3.546,
      "pause_after": 1.4665999999996249,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ra ngoài rồi! Đứng dưới đèn đường, kiểm tra xem cả ba có đủ không.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 230.517,
      "end": 235.4313,
      "duration": 4.9143,
      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Một, hai, ba... đủ cả. Nhưng trên tay Bubu có vết mực mới, giống hệt dòng chữ trong cuốn sổ.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 236.0568,
      "end": 241.0203,
      "duration": 4.9635,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Dòng chữ gì cơ? 'Lần sau, hãy gõ bốn tiếng'. Không thể nào... mình đâu có mang cuốn sổ ra!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 241.6728,
      "end": 245.7413,
      "duration": 4.0685,
      "pause_after": 0.9384000000003656,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Về nhà ngay. Chuyện này chưa kết thúc, nhưng lần tới chúng ta sẽ không đi vào đó một mình.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    }
  ]
}