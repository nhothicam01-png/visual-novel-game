        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ba lần sáng, một lần tối. Chúng ta gõ lại đúng ba tiếng, rồi chờ. Không được gõ tiếng thứ tư.",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 87.4012,
      "end": 92.0916,
      "duration": 4.6904,
      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
