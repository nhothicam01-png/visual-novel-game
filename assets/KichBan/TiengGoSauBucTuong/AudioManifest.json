          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nhưng tầng hai đã bị khóa nhiều năm. Nếu có người bên trong thì họ vào bằng cách nào?",
      "gain": 1,
