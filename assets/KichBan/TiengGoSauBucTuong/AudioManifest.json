      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nhìn này, đèn hành lang chớp theo nhịp ba lần. Có lẽ Bubu đang cố gửi tín hiệu cho chúng ta.",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 82.0196,
      "end": 87.1512,
      "duration": 5.1316,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ba lần sáng, một lần tối. Chúng ta gõ lại đúng ba tiếng, rồi chờ. Không được gõ tiếng thứ tư.",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 87.4012,
      "end": 91.9755,
      "duration": 4.5743,
      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cộc... cộc... cộc! Có tiếng đáp lại từ sau bức tường. Bubu, nếu nghe thấy thì lùi khỏi cửa nhé!",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 92.2255,
      "end": 95.6969,
      "duration": 3.4714,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
