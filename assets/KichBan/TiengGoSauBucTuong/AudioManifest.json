          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Chiếc chìa khóa vừa khớp với ổ khóa dưới chân kệ sách. Có tiếng chốt cửa bật ra rồi!",
      "gain": 1,
      "scene_index": 4,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 134.0208,
      "end": 138.2395,
      "duration": 4.2187,
      "pause_after": 0.7985999999996185,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Pipun, lùi sang phải. Mình sẽ kéo cánh cửa này, cậu đừng đứng ngay trước khe mở!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 139.4858,
      "end": 144.0801,
      "duration": 4.5943,
      "pause_after": 0.3939000000003663,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình giữ được rồi! Nhưng phía sau cửa không phải căn phòng... nó giống một hành lang khác đang xoay vòng!",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 144.877,
      "end": 149.7795,
      "duration": 4.9025,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình thấy ánh đèn của hai cậu! Mình đang ở sát cửa, nhưng có một cái bóng đứng chắn giữa chúng ta!",
      "gain": 1,
      "scene_index": 6,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 150.4002,
      "end": 152.8894,
      "duration": 2.4892,
      "pause_after": 2.543299999998874,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu, cúi xuống! Cái bóng vừa lao về phía cậu!",
      "gain": 1,
      "scene_index": 7,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 155.8515,
      "end": 160.5201,
      "duration": 4.6686,
      "pause_after": 0.40480000000072813,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Á! Mình né được rồi. Cái bóng đập vào kệ sách, còn chiếc chìa khóa vẫn ở trong tay mình!",
      "gain": 1,
      "scene_index": 8,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 161.3596,
      "end": 164.941,
      "duration": 3.5814,
      "pause_after": 1.3883000000007488,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Cánh cửa đã mở hẳn! Bubu, chạy về phía ánh đèn, đừng nhìn lại!",
      "gain": 1,
      "scene_index": 9,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 166.786,
      "end": 168.2799,
      "duration": 1.4939,
      "pause_after": 3.4920999999996187,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình chạy đây! Đợi mình với!",
      "gain": 1,
      "scene_index": 10,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 172.3203,
      "end": 175.0796,
      "duration": 2.7593,
      "pause_after": 2.2364000000003674,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Bubu đã ra tới hành lang! Rerin, kéo cậu ấy qua đây!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 177.7636,
      "end": 179.9225,
      "duration": 2.1589,
      "pause_after": 2.8740999999996237,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nắm lấy tay mình! Một, hai, ba... kéo!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 183.2758,
      "end": 187.2623,
      "duration": 3.9865,
      "pause_after": 1.0550999999996353,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình ra được rồi! Hai cậu có sao không? Mình xin lỗi vì đã tự ý tách nhóm.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 188.7088,
      "end": 193.4632,
      "duration": 4.7544,
      "pause_after": 0.30190000000038175,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không sao, nhưng lần sau phải đi cùng nhau. Nhìn sau lưng cậu kìa... cái bóng vẫn đang ở trong đó!",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 194.131,
      "end": 198.9095,
      "duration": 4.7785,
      "pause_after": 0.260599999999636,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng quay lại. Chúng ta rời khỏi đây theo lối cầu thang, giữ khoảng cách vừa đủ và nhìn thấy nhau.",
      "gain": 1,
      "scene_index": 11,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 199.556,
      "end": 203.9098,
      "duration": 4.3538,
      "pause_after": 0.6771999999992548,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Sân trường đây rồi! Nhưng đồng hồ trên tường vẫn đứng đúng ở thời điểm chúng ta bước vào.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 205.0012,
      "end": 208.1798,
      "duration": 3.1786,
      "pause_after": 1.8296999999992298,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Mình tưởng đã thoát, nhưng tiếng gõ lại vang lên từ phía sau cổng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 210.423,
      "end": 215.5235,
      "duration": 5.1005,
      "pause_after": 0.25,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Không ai trả lời. Cứ đi tiếp. Ba tiếng gõ không còn là lời gọi nữa, nó đang cố bắt chước chúng ta.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 216.2571,
      "end": 219.2931,
      "duration": 3.036,
      "pause_after": 1.8895999999996267,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Khoan, nhìn bóng của ba đứa mình trên nền. Có bốn cái bóng!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 221.6713,
      "end": 223.3696,
      "duration": 1.6983,
      "pause_after": 3.2934000000003554,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đừng đếm nữa! Chạy ra cổng thôi!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 227.2002,
      "end": 230.8497,
      "duration": 3.6495,
      "pause_after": 1.3316000000014814,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ra ngoài rồi! Đứng dưới đèn đường, kiểm tra xem cả ba có đủ không.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 232.7331,
      "end": 237.7656,
      "duration": 5.0325,
      "pause_after": 0.25,
      "speaker": "Pipun",
      "speaker_id": "char_pipun_char_02",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Một, hai, ba... đủ cả. Nhưng trên tay Bubu có vết mực mới, giống hệt dòng chữ trong cuốn sổ.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 238.4798,
      "end": 243.5694,
      "duration": 5.0896,
      "pause_after": 0.25,
      "speaker": "Bubu",
      "speaker_id": "char_bubu_char_01",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "",
        "piper_voice_id": "",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Dòng chữ gì cơ? 'Lần sau, hãy gõ bốn tiếng'. Không thể nào... mình đâu có mang cuốn sổ ra!",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 244.2028,
      "end": 248.2692,
      "duration": 4.0664,
      "pause_after": 0.9639000000003595,
      "speaker": "Rerin",
      "speaker_id": "char_rerin_char_03",
      "voice_id": "",
      "voice": {
        "profile_id": "",
        "profile_name": "",
        "source_voice_id": "vi_VN-vais1000-medium",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "",
        "gender": "",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Về nhà ngay. Chuyện này chưa kết thúc, nhưng lần tới chúng ta sẽ không đi vào đó một mình.",
      "gain": 1,
      "scene_index": 12,
      "timing_policy": "fixed_source_window"
    }
  ]
