          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Đèn ở tầng hai vừa chớp tắt. Có bóng người đứng sau ô cửa cuối hành lang kìa!",
      "gain": 1,
      "scene_index": 0,
