          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Một đường nứt vừa mở ra cạnh khung cửa. Mình thấy ánh đèn xanh ở bên trong!",
      "gain": 1,
      "scene_index": 3,
