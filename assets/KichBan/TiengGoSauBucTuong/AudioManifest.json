          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Ủa? Đây không phải phòng học. Sao mình vừa bước qua cửa mà lại thành thư viện?",
      "gain": 1,
      "scene_index": 2,
