      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 92.3184,
      "end": 95.8711,
      "duration": 3.5526,
      "pause_after": 0.25,
      "speaker": "Rerin",
