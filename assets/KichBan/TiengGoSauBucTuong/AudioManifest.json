          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Nhìn này, đèn hành lang chớp theo nhịp ba lần. Có lẽ Bubu đang cố gửi tín hiệu cho chúng ta.",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 82.1938,
      "end": 87.2673,
