          "pitch": 0,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi-VN",
        "engine": "edge"
      },
      "text": "Chúng ta chỉ quan sát từ hành lang sáng đèn. Không ai tự ý đi sâu vào trong, nghe chưa?",
      "gain": 1,
      "scene_index": 0,
      "timing_policy": "fixed_source_window"
    },
    {
