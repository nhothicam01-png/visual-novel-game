          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Các ngươi đã đến đúng hẹn. Hẻm Núi Sương Mờ chưa bao giờ từ chối những kẻ dám thách thức quy luật của Cổ Thụ.",
      "gain": 1,
      "scene_index": 5,
      "timing_policy": "fixed_source_window"
    },
    {
