        "gender": "female",
        "settings": {
          "speed": 1,
          "pitch": 0,
          "rough": 5,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Tôi sẽ đưa cô ấy đến Hẻm Núi Sương Mờ. Dù phải đối đầu với cả triều đình, tôi cũng không để họ biến Nesta thành vật tế thần.",
      "gain": 1,
      "scene_index": 4,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
