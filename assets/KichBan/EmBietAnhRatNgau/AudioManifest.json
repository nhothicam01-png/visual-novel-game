          "pitch": 0,
          "rough": 5,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Cảm ơn ngươi đã dẫn đường đến tận đây, pháp sư già. Chiếc trâm bạc và ấn ký trên người con bé này chính là thứ ta cần để lật đổ ngai vàng!",
      "gain": 1,
      "scene_index": 6,
      "timing_policy": "fixed_source_window"
    },
    {
