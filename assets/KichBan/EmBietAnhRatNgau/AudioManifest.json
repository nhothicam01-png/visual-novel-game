        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "vi-VN-NamMinhNeural",
        "gender": "male",
        "settings": {
          "speed": 1,
          "pitch": 8,
          "rough": 11,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Cổ Thụ Sinh Mệnh đang cựa mình. Một chiếc lá đỏ vừa rơi xuống, và thêm một sinh mạng nữa đã vĩnh viễn tàn lụi.",
      "gain": 1,
      "scene_index": 2,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
