      "voice_id": "voice_1794303742118",
      "voice": {
        "profile_id": "voice_1794303742118",
        "profile_name": "Giọng bé",
        "source_voice_id": "vi-VN-HoaiMyNeural",
        "piper_voice_id": "vi_VN-vais1000-medium",
        "edge_voice_id": "vi-VN-HoaiMyNeural",
        "gender": "female",
        "settings": {
          "speed": 1,
          "pitch": 2,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Lirien nói đúng. Dược liệu tôi điều chế có thể kìm hãm ấn ký trên lưng Nesta, nhưng chỉ có thể duy trì khi rời khỏi kinh thành này.",
      "gain": 1,
      "scene_index": 3,
      "timing_policy": "fixed_source_window"
    },
    {
      "type": "dialogue",
      "start": 35.6963,
