          "speed": 1,
          "pitch": 2,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Công ty mình tên pháp lý là gì ạ? Em có thể xem mã số doanh nghiệp và mô tả công việc trước không?",
      "gain": 1,
      "scene_index": 1,
