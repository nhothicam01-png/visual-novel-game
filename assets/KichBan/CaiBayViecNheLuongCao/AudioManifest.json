          "speed": 1,
          "pitch": 2,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Ảnh chụp màn hình thì ai cũng làm giả được. Cậu đừng vội gửi giấy tờ hay chuyển tiền nhé.",
      "gain": 1,
      "scene_index": 0,
