          "pitch": 2,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Sáng hôm sau, tôi thấy cùng một lời mời được dán ở bảng thông báo gần thư viện. Mức lương nổi bật đến mức người đi ngang cũng phải dừng lại.",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
