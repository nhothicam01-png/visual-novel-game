          "speed": 1,
          "pitch": 2,
          "rough": 0,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Nếu công việc không mất phí thì tại sao phải giới hạn thông tin công ty?",
