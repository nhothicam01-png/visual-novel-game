          "speed": 1,
          "pitch": 0,
          "rough": 5,
          "volume": 100
        },
        "source_language": "vi",
        "engine": "edge"
      },
      "text": "Chào em, anh là Đạt, phụ trách tuyển cộng tác viên. Bên anh đang cần người làm nhiệm vụ đánh giá sản phẩm và xử lý đơn. Thu nhập từ sáu trăm nghìn đến hơn một triệu mỗi ngày.",
      "gain": 1,
      "scene_index": 1,
      "timing_policy": "fixed_source_window"
    },
    {
